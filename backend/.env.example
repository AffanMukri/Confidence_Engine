# Server settings
HOST=0.0.0.0
PORT=8765
ALLOWED_ORIGINS=https://confidence-engine.netlify.app,http://localhost:8765,http://127.0.0.1:8765

# Recommended in production. Standard postgres:// and postgresql:// URLs are
# automatically converted to the asyncpg SQLAlchemy driver URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional tuning
MP_DELEGATE=CPU
TARGET_FPS=10
SCORE_UPDATE_INTERVAL=2.0
